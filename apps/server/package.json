{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"test": "bun test"
	},
	"dependencies": {
		"@ai-sdk/provider": "catalog:",
		"@ai-sdk/provider-utils": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"@video-platform-challenge/ai": "workspace:*",
		"@video-platform-challenge/api": "workspace:*",
		"@video-platform-challenge/auth": "workspace:*",
		"@video-platform-challenge/db": "workspace:*",
		"@video-platform-challenge/env": "workspace:*",
		"@video-platform-challenge/kie": "workspace:*",
		"@video-platform-challenge/storage": "workspace:*",
		"@video-platform-challenge/types": "workspace:*",
		"ai": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@video-platform-challenge/config": "workspace:*",
		"alchemy": "catalog:",
		"tsdown": "^0.22.3",
		"typescript": "catalog:",
		"wrangler": "catalog:"
	}
}
