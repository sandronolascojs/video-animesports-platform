{
  "name": "video-platform-challenge",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@cloudflare/workers-types": "^4.20260702.1",
      "hono": "^4.12.27",
      "@orpc/server": "^1.14.6",
      "@orpc/openapi": "^1.14.6",
      "@orpc/zod": "^1.14.6",
      "better-auth": "1.6.23",
      "alchemy": "^0.93.12",
      "wrangler": "^4.107.0",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "@orpc/client": "^1.14.6",
      "@tailwindcss/postcss": "^4.3.2",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @video-platform-challenge/db",
    "db:studio": "turbo run db:studio -F @video-platform-challenge/db",
    "db:generate": "turbo run db:generate -F @video-platform-challenge/db",
    "db:migrate": "turbo run db:migrate -F @video-platform-challenge/db",
    "deploy": "turbo run deploy -F @video-platform-challenge/infra",
    "destroy": "turbo run destroy -F @video-platform-challenge/infra",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@video-platform-challenge/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^22.13.14",
    "@video-platform-challenge/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write ."
    ]
  },
  "packageManager": "bun@1.3.13"
}
