{
	"name": "video-platform-challenge",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"drizzle-orm": "^0.45.2",
			"@neondatabase/serverless": "^1.1.0",
			"typescript": "^6.0.3",
			"@cloudflare/workers-types": "^5.20260710.1",
			"@types/node": "^26.1.1",
			"hono": "^4.12.27",
			"@orpc/server": "^1.14.6",
			"@orpc/contract": "^1.14.6",
			"@orpc/openapi": "^1.14.6",
			"@orpc/zod": "^1.14.6",
			"better-auth": "1.6.23",
			"alchemy": "^0.93.12",
			"wrangler": "^4.107.0",
			"lucide-react": "^1.23.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.7",
			"react-dom": "^19.2.7",
			"sileo": "^0.1.5",
			"@orpc/client": "^1.14.6",
			"aws4fetch": "^1.0.20",
			"@tailwindcss/postcss": "^4.3.2",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.2",
			"remotion": "4.0.487",
			"@remotion/player": "4.0.487",
			"zustand": "^5.0.14",
			"ai": "^7.0.22",
			"@ai-sdk/gateway": "4.0.16",
			"@ai-sdk/provider-utils": "5.0.7",
			"@ai-sdk/provider": "4.0.3",
			"@types/bun": "^1.3.14",
			"mediabunny": "^1.50.8",
			"evalite": "0.19.0",
			"vitest": "^4.1.10"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"dev:web": "turbo run dev -F web",
		"dev:server": "turbo run dev -F server",
		"db:push": "turbo run db:push -F @video-platform-challenge/db",
		"db:studio": "turbo run db:studio -F @video-platform-challenge/db",
		"db:generate": "turbo run db:generate -F @video-platform-challenge/db",
		"db:migrate": "turbo run db:migrate -F @video-platform-challenge/db",
		"deploy": "turbo run deploy -F @video-platform-challenge/infra",
		"destroy": "turbo run destroy -F @video-platform-challenge/infra",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@video-platform-challenge/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@cloudflare/workers-types": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@video-platform-challenge/config": "workspace:*",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"turbo": "^2.10.2",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"packageManager": "bun@1.3.13"
}
